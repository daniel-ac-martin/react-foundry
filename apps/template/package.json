{
  "name": "@react-foundry/template",
  "version": "0.5.4",
  "description": "A starting point for writing a new React Foundry application.",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "start": "node .",
    "start:test": "COOKIES_SECURE=no node .",
    "test": "npm run test:unit",
    "test:ci": "npm test && npm run test:functional:ci",
    "test:functional": "cypress run ${CYPRESS_PROJECT_ID:+--record ${CYPRESS_FLAGS}}",
    "test:functional:ci": "start-server-and-test 'start:test' 'http-get://localhost:8080/readiness' test:functional",
    "test:unit": "jest --passWithNoTests",
    "build": "npm run build:app && npm run build:server",
    "build:app": "react-router build",
    "build:server": "vite -c vite.config.server.ts build",
    "heroku-postbuild": "npm run build",
    "clean": "rm -rf dist/ pkg/ node_modules/.vite/ node_modules/.vite-temp/ .react-router/",
    "dev": "NODE_ENV=development bun --watch --inspect ./src/server/dev.ts",
    "cypress": "cypress open",
    "create": "plop",
    "create:deployment": "plop deployment",
    "create:page": "plop page",
    "typecheck": "react-router typegen && tsc"
  },
  "author": "Daniel A.C. Martin <npm@daniel-martin.co.uk> (http://daniel-martin.co.uk/)",
  "license": "MIT",
  "dependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@react-foundry/anchor-list": "workspace:*",
    "@react-foundry/components": "workspace:*",
    "@react-foundry/fastify": "workspace:*",
    "@react-foundry/fastify-react-router": "workspace:*",
    "@react-foundry/react-router-context": "workspace:*",
    "@react-foundry/router": "workspace:*",
    "@react-router/fs-routes": "8.3.0",
    "@react-router/node": "8.3.0",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "serverless-http": "4.0.0"
  },
  "peerDependencies": {
    "@react-foundry/user-info": "^0.5.4"
  },
  "devDependencies": {
    "@react-foundry/app-plop-pack": "workspace:*",
    "@react-foundry/vite-html-react": "workspace:*",
    "@react-router/dev": "8.3.0",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun": "1.4.0",
    "cypress": "15.20.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "sass-embedded": "1.102.0",
    "start-server-and-test": "3.0.12",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
