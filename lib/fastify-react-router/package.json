{
  "name": "@react-foundry/fastify-react-router",
  "version": "0.5.4",
  "description": "Fastify plugin for React Router.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev.ts"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./dev": {
        "types": "./dist/dev.d.ts",
        "import": "./dist/dev.js",
        "default": "./dist/dev.js"
      }
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepublishOnly": "npm run clean && npm run build",
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "author": "Daniel A.C. Martin <npm@daniel-martin.co.uk> (http://daniel-martin.co.uk/)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^10.1.3",
    "@react-foundry/react-router-context": "workspace:^",
    "@react-router/node": "^8.3.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@react-foundry/fastify-auth": "workspace:*",
    "@react-foundry/fastify-harden": "workspace:*",
    "fastify": "5.12.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "react-router": "8.3.0",
    "rollup": "4.62.4",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "react-router": "^8.3.0",
    "vite": "^8.2.2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
